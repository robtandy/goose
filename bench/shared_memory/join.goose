// The hash join of docs/design/shared_memory.md, section 6, as a benchmark
// of frozen regions (#4): W workers, P partitions, a build side of (i64 key,
// i64 payload) rows and a probe side of i64 keys, generated by main and
// frozen as columns. Phases 1 and 2 are test/shared/shared_join.goose's:
// workers partition their build morsels onto dynamic stacks and freeze
// them, then build partitions' tables chained by self-relative links. In
// phase 3, `frozen` freezes each table, and every worker probes every table
// in place; `copies` gives every worker a private copy of each table
// instead, through a queue, as a program shares them without frozen
// regions: each builder puts its table to main with its chains as indices
// (a link does not survive a copy), main gathers them into one message and
// puts it once for each worker (a queue delivers to whichever worker takes
// a message, so every worker's must be the same), and each worker links
// its copy again in an array of its own and probes it with the same loop.
//
//     goose build -O2 --cc clang -o join bench/shared_memory/join.goose
//     ./join frozen 16 64 16000000 64000000
//     ./join copies 16 64 16000000 64000000
//
// prints the build and probe throughputs, the copy-in time, the matches,
// and the process's peak resident memory (Linux's VmHWM). Every worker
// starts probing at once, in both modes, once all have their tables.
import std;
import os;

struct Row { key: i64, payload: i64 }
struct Run { part: i64, start: i64, count: i64 }
struct Entry { key: i64, payload: i64, next: Entry&<u32>? }
// A table entry in a message: its chain's next entry by index + 1, 0 for none.
struct Flat { key: i64, payload: i64, next: u32 }
struct Copy { part: i64, heads: i64, entries: Flat[] }
// Every table, one after another, for one worker: where each starts, and
// its heads.
struct Copies { starts: i64[..1024], heads: i64[..1024], entries: Flat[] }
struct Result { matches: i64, sum: i64 }

struct Job {
    arena: resource<shared>,
    bkeys: resource<frozen<i64>>, bpays: resource<frozen<i64>>, pkeys: resource<frozen<i64>>,
    parts: i64, workers: i64, worker: i64, copies: bool,
}
struct Partitioned { rows: resource<frozen<Row>>, runs: resource<frozen<Run>> }
struct Task { part: i64, inputs: resource<frozen<Partitioned>> }
struct Built { part: i64, table: resource<frozen<Entry>>, heads: i64, entries: i64 }
// What phase 3 took a worker: copying in, and probing.
struct Probed { res: Result, copyns: i64, probens: i64 }
struct Ready { worker: i64 }
struct Go { worker: i64 }

let MORSEL = 65536;

checkfree inline fn mix(k: i64) -> i64 { ((k as! u64) * 0x9E3779B97F4A7C15 >> 1) as! i64 }

checkfree fn flush(buf: Row[..64]&, p: i64, rows: Row[>..]&, runs: Run[>..]&) {
    runs.push(Run { part: p, start: rows.len, count: buf.len });
    rows.append(buf);
    buf.clear();
}

checkfree fn scatter(keys: const i64[:], pays: const i64[:], bufs: Row[..64][>..]&,
                     rows: Row[>..]&, runs: Run[>..]&) {
    assert(pays.len == keys.len);
    for i in keys.len {
        let h = mix(keys[i]);
        let p = h % bufs.len;
        bufs[p].push(Row { key: keys[i], payload: pays[i] });
        if bufs[p].len == bufs[p].cap { flush(bufs[p], p, rows, runs); }
    }
}

fn partition(sh: shared&, job: Job&, rows: Row[>..]&, runs: Run[>..]&) {
    let keys = sh.view(job.bkeys);
    let pays = sh.view(job.bpays);
    var bufs: Row[..64][>..] = [];
    for p in job.parts { bufs.push([]); }
    var first = job.worker * MORSEL;
    while first < keys.len {
        let n = min(MORSEL, keys.len - first);
        scatter(keys[first..first + n], pays[first..first + n], bufs, rows, runs);
        first += job.workers * MORSEL;
    }
    for p in bufs.len { if bufs[p].len > 0 { flush(bufs[p], p, rows, runs); } }
}

checkfree fn insert(t: Entry[>..]&, heads: i64, rows: const Row[:]) {
    assert(heads > 0 && heads <= t.len);
    for r in rows {
        let h = mix(r.key) >> 7;
        let b = h % heads;
        let e .= t.push(Entry { key: r.key, payload: r.payload, next: t[b].next });
        t[b].next .= e;
    }
}

// The same chains by index, for a copy.
checkfree fn insert_flat(t: Flat[>..]&, heads: i64, rows: const Row[:]) {
    assert(heads > 0 && heads <= t.len);
    for r in rows {
        let h = mix(r.key) >> 7;
        let b = h % heads;
        t.push(Flat { key: r.key, payload: r.payload, next: t[b].next });
        t[b].next = t.len as! u32;
    }
}

fn rows_of(sh: shared&, inputs: const Partitioned[:], part: i64) -> i64 {
    var n = 0;
    for w in inputs { for r in sh.view(w.runs) { if r.part == part { n += r.count; } } }
    n
}

fn build(sh: shared&, inputs: const Partitioned[:], part: i64, t: Entry[>..]&) -> i64 {
    let heads = next_pow2(max(rows_of(sh, inputs, part), 1));
    for i in heads { t.push(Entry { key: 0, payload: 0, next: null }); }
    for w in inputs {
        let rows = sh.view(w.rows);
        for r in sh.view(w.runs) {
            if r.part == part { insert(t, heads, rows[r.start..r.start + r.count]); }
        }
    }
    heads
}

fn build_flat(sh: shared&, inputs: const Partitioned[:], part: i64, t: Flat[>..]&) -> i64 {
    let heads = next_pow2(max(rows_of(sh, inputs, part), 1));
    for i in heads { t.push(Flat { key: 0, payload: 0, next: 0 }); }
    for w in inputs {
        let rows = sh.view(w.rows);
        for r in sh.view(w.runs) {
            if r.part == part { insert_flat(t, heads, rows[r.start..r.start + r.count]); }
        }
    }
    heads
}

checkfree fn probe(tables: const (const Entry[:])[:], keys: const i64[:], res: Result&) {
    for k in keys {
        let h = mix(k);
        let t = tables[h % tables.len];
        let b = h >> 7;
        var e = t[b % t.len].next;
        while e {
            if e.key == k {
                res.matches += 1;
                res.sum += e.payload;
            }
            e .= e.next;
        }
    }
}

fn probe_all(sh: shared&, job: Job&, tables: const (const Entry[:])[:]) -> Result {
    let keys = sh.view(job.pkeys);
    var res = Result { matches: 0, sum: 0 };
    var first = job.worker * MORSEL;
    while first < keys.len {
        let n = min(MORSEL, keys.len - first);
        probe(tables, keys[first..first + n], res);
        first += job.workers * MORSEL;
    }
    res
}

// A worker's private copy of every table, linked again in one array: the
// tables' cuts are views of it.
fn copy_in(all: Entry[>..]&, starts: i64[>..]&, heads: i64[>..]&) {
    let c = qget<Copies>();
    for e in c.entries { all.push(Entry { key: e.key, payload: e.payload, next: null }); }
    for p in c.starts.len {
        let base = c.starts[p];
        for i in (if p + 1 < c.starts.len { c.starts[p + 1] } else { c.entries.len }) - base {
            let n = c.entries[base + i].next as i64;
            if n > 0 { all[base + i].next .= all[base + n - 1]; }
        }
        starts.push(base);
        heads.push(c.heads[p]);
    }
}

thread_fn join_worker(job: Job) {
    let sh = attach(job.arena);
    var rows = dynamic_stack<Row> {};
    var runs = dynamic_stack<Run> {};
    partition(sh, job, rows.items, runs.items);
    qput(Partitioned { rows: sh.freeze(rows), runs: sh.freeze(runs) });
    var t = dynamic_stack<Entry> {};
    var flat: Flat[>..] = [];
    loop {
        let task = qget<Task>();
        guard task.part >= 0 else { break; }
        if job.copies {
            flat.clear();
            let heads = build_flat(sh, sh.view(task.inputs), task.part, flat);
            qput(Copy { part: task.part, heads: heads, entries: copy(flat) });
            qput(Built { part: task.part, table: default<resource<frozen<Entry>>>(), heads: heads,
                         entries: flat.len });
        } else {
            let heads = build(sh, sh.view(task.inputs), task.part, t.items);
            let n = t.items.len;
            qput(Built { part: task.part, table: sh.freeze(t), heads: heads, entries: n });
        }
    }
    let dir = qget<resource<frozen<Built>>>();
    let t0 = clock_ns();
    var all: Entry[>..] = [];
    var starts: i64[>..] = [];
    var heads: i64[>..] = [];
    var tables: (const Entry[:])[..1024] = [];
    if job.copies {
        copy_in(all, starts, heads);
        for p in job.parts { tables.push(all[starts[p]..starts[p] + heads[p]]); }
    } else {
        for b in sh.view(dir) { tables.push(sh.view(b.table)[..b.heads]); }
    }
    let t1 = clock_ns();
    // Every worker probes at once, as with the frozen tables, once all
    // have their copies.
    qput(Ready { worker: job.worker });
    qget<Go>();
    let t2 = clock_ns();
    let res = probe_all(sh, job, tables);
    qput(Probed { res: res, copyns: t1 - t0, probens: clock_ns() - t2 });
}

// Peak resident memory, from /proc/self/status, in MB; -1 where there is none.
fn peak_mb() -> i64 {
    var s: u8[>..] = [];
    if !read_file("/proc/self/status", s) { return -1; }
    let key = "VmHWM:";
    for i in s.len {
        if i + key.len <= s.len && s[i..i + key.len] == key {
            var j = i + key.len;
            var kb = 0;
            while j < s.len && (s[j] == ' ' || s[j] == '\t') { j++; }
            while j < s.len && s[j] >= '0' && s[j] <= '9' {
                kb = kb * 10 + (s[j] - '0');
                j++;
            }
            return kb / 1024;
        }
    }
    -1
}

fn number(i: i64, fallback: i64) -> i64 {
    let a = args();
    if i >= a.len { return fallback; }
    var n = 0;
    for c in a[i] { n = n * 10 + (c - '0'); }
    n
}

fn main() {
    let a = args();
    let copies = a.len > 1 && a[1] == "copies";
    let w = number(2, 16);
    let p = number(3, 64);
    let nb = number(4, 16000000);
    let np = number(5, 64000000);
    let sh = shared {};
    var bk = dynamic_stack<i64> {};
    var bp = dynamic_stack<i64> {};
    var pk = dynamic_stack<i64> {};
    var r = rng { s: 7 };
    // Build keys unique, probe keys a quarter of them each hit.
    for i in nb {
        bk.items.push(i * 7 + 3);
        bp.items.push((rand_u64(r) % 1000) as i64);
    }
    for i in np { pk.items.push(((rand_u64(r) % ((4 * nb) as u64)) as i64) * 7 + 3); }
    let bkeys = sh.freeze(bk);
    let bpays = sh.freeze(bp);
    let pkeys = sh.freeze(pk);
    let start = clock_ns();
    var ids: i64[>..] = [];
    for i in w {
        ids.push(thread_spawn(join_worker, Job { arena: sh.handle, bkeys: bkeys, bpays: bpays,
                                                 pkeys: pkeys, parts: p, workers: w, worker: i,
                                                 copies: copies }));
    }
    var dir = dynamic_stack<Partitioned> {};
    for i in w { dir.items.push(qget<Partitioned>()); }
    let partitioned = clock_ns();
    let inputs = sh.freeze(dir);
    for part in p { qput(Task { part: part, inputs: inputs }); }
    for i in w { qput(Task { part: -1, inputs: inputs }); }
    var came: Built[>..] = [];
    for part in p { came.push(qget<Built>()); }
    let built_at = clock_ns();
    var entries = 0;
    var built = dynamic_stack<Built> {};
    for part in p {
        for b in came {
            if b.part == part {
                built.items.push(b);
                entries += b.entries;
            }
        }
    }
    let tables = sh.freeze(built);
    for i in w { qput(tables); }
    // The copies: every table, gathered in partition order, then once for
    // each worker into the queue.
    let gather = clock_ns();
    if copies {
        var got: Copy[>..] = [];
        for part in p { got.push(qget<Copy>()); }
        var starts: i64[..1024] = [];
        var heads: i64[..1024] = [];
        var flat: Flat[>..] = [];
        for part in p {
            for c in got {
                if c.part == part {
                    starts.push(flat.len);
                    heads.push(c.heads);
                    flat.append(c.entries);
                }
            }
        }
        let msg = Copies { starts: starts, heads: heads, entries: copy(flat) };
        for i in w { qput(msg); }
    }
    let put = clock_ns();
    for i in w { qget<Ready>(); }
    for i in w { qput(Go { worker: i }); }
    var res = Result { matches: 0, sum: 0 };
    var copyns = 0;
    var probens = 0;
    for i in w {
        let q = qget<Probed>();
        res.matches += q.res.matches;
        res.sum += q.res.sum;
        copyns = max(copyns, q.copyns);
        probens = max(probens, q.probens);
    }
    let done = clock_ns();
    for id in ids { thread_wait(id); }
    let buildns = built_at - start;
    print(if copies { "copies" } else { "frozen" }, ": W = ", w, ", P = ", p, ", ", nb,
          " build rows, ", np, " probe rows");
    print("  phase 1, partition: ", (partitioned - start) / 1000000, " ms; phase 2, tables: ",
          (built_at - partitioned) / 1000000, " ms; build ", nb * 1000 / max(buildns / 1000000, 1),
          " rows/s");
    let held: u8[>..] = if copies { str(w, " private copies, ", w * entries * 20 / 1000000, " MB") }
                        else { str("shared, no copy") };
    print("  tables: ", entries, " entries, ", entries * 20 / 1000000, " MB; ", held);
    if copies { print("  main gathers the copies and puts them: ", (put - gather) / 1000000, " ms"); }
    print("  phase 3: copy-in ", copyns / 1000000, " ms, probe ", probens / 1000000,
          " ms; probe ", np * 1000 / max(probens / 1000000, 1), " rows/s, with the copy-in ",
          np * 1000 / max((probens + copyns) / 1000000, 1), " rows/s");
    print("  ", res.matches, " matches, payloads summing to ", res.sum, "; total ",
          (done - start) / 1000000, " ms; peak resident ", peak_mb(), " MB");
}

